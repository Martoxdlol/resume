---
import SectionTitle from "./SectionTitle.astro";

export interface Props {
  title?: string;
  note?: string;
}

const { title, note } = Astro.props;
---

<section class="mb-3 [&_p]:text-[13px]">
  {
    title && (
      <SectionTitle>
        {title}
        {note && (
          <span class="normal-case tracking-normal font-normal text-stone-400">
            · {note}
          </span>
        )}
      </SectionTitle>
    )
  }
  <slot />
</section>
